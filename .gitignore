__pycache__/
*.pyc
*.jpg
*.cache
*.txt
*.db

# LOCO raw data (downloaded/extracted, not committed) -- keeps dataset/*.py
# scripts and dataset/results/*.csv trackable
dataset/loco.zip
dataset/dataset/
dataset/annotations/
dataset/loco_eval_results.json

# YOLO training artifacts, derived from the LOCO raw data above via
# convert_loco_to_yolo.py -- regenerable, not committed
dataset/yolo/
dataset/yolo_papersplit/
dataset/yolo_runs/
dataset/loco_train_paths.txt
dataset/loco_val_paths.txt
dataset/loco_papersplit_train_paths.txt
dataset/loco_papersplit_val_paths.txt
dataset/*.pt
runs/
weights/

# SAM3 pseudo-labels generated from assets/frames_2fps -- regenerable via
# generate_sam3_pseudo_dataset.py / split_pseudo_bank.py, not committed
dataset/sam3_v6_pseudo/labels/
dataset/sam3_v6_pseudo_split/labels/
dataset/sam3_v6_pseudo_split_random/labels/

# SAM3 pseudo-labels for LOCO images with no official annotation -- regenerable
# via generate_sam3_loco_unannotated.py, held for manual review before being
# used for anything, not committed
dataset/loco_unannotated_sam3_pseudo/

# 6-class (5 LOCO + iw_hub) SAM3 pseudo-labels for the robot-class fine-tune
# experiments -- regenerable via add_robot_class_to_pseudo.py (video-only) and
# build_mixed_robot_dataset.py (video + LOCO mix), not committed
dataset/sam3_v6_pseudo_split_with_robot/labels/
dataset/sam3_v6_pseudo_mixed_with_robot/labels/

# generated demo output, not source
assets/output_sam3.mp4

# benchmark report is generated by dataset/generate_report.py / CI, not source
docs/
.venv/
.txt

# pretrained checkpoint auto-downloaded to the repo root by ultralytics when
# no local baseline path is given (e.g. training a new-scale baseline) --
# same "not committed" treatment as dataset/*.pt and runs/ above
/yolov8l.pt

# per-round training batches (build_training_batch.py + copy_paste_augment.py
# output) -- regenerated fresh every fine-tune round, not committed, same
# philosophy as runs/ above
dataset/pipeline/training_batches/
# pipeline data and experiment outputs -- regenerable, not committed
dataset/coco/
dataset/loco_unannotated_full/
dataset/pipeline/logs/
dataset/pipeline/saturation/
dataset/pipeline/self_training/
dataset/pipeline/specialist_batches/
